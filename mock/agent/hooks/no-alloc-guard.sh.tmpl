#!/usr/bin/env bash
# @matchers: Write, Edit
# @timeout: 5
# Agent hook: block alloc/Vec/Box/String + bare Option/Result in the no_std
# vehje crates.
#
# Scope: vehje-ir / vehje-lex / vehje-syntax / vehje-runtime-*. The
# compiler phases (resolve, typecheck, schedule, codegen) and CLI binary
# may use std; they're not caught here.
#
# Mirrors the mockspace `forbidden-imports` lint + the notko primitive
# vocabulary. Tasks #77, #78.

set -uo pipefail

__INPUT=$(cat)

{{HOOK_HELPERS}}

FILE_PATH=$(_extract file_path)
COMMAND=""
_scope_or_allow

TARGET="$FILE_PATH"
CONTENT=$(_extract new_string)
if [[ -z "$CONTENT" ]]; then
    CONTENT=$(_extract content)
fi

# Only fire on no_std crates.
if ! echo "$TARGET" | grep -qE "mock/crates/(vehje-ir|vehje-lex|vehje-syntax|vehje-runtime-[a-z]+)/src/"; then
    allow
fi

if echo "$CONTENT" | grep -qE '^\s*(pub\s+)?use\s+alloc::'; then
    deny "BLOCKED: \`use alloc::\` in a vehje no_std crate. Reshape the API to take a caller-provided buffer or trait bound."
fi

if echo "$CONTENT" | grep -qE '^\s*extern\s+crate\s+alloc'; then
    deny "BLOCKED: \`extern crate alloc\` in a vehje no_std crate. Remove it; the no_std attribute is load-bearing."
fi

if echo "$CONTENT" | grep -qE '(^|[^a-zA-Z0-9_])Vec<'; then
    deny "BLOCKED: \`Vec<T>\` in a vehje no_std crate. Take \`&[T]\` / \`impl IntoIterator<Item = T>\` or a trait-bound sink (\`&mut impl Collector<T>\`)."
fi

if echo "$CONTENT" | grep -qE '(^|[^a-zA-Z0-9_])String([^a-zA-Z0-9_]|$)'; then
    deny "BLOCKED: \`String\` in a vehje no_std crate. Use \`&'static str\` or \`hilavitkutin_str::Str\`."
fi

if echo "$CONTENT" | grep -qE '(^|[^a-zA-Z0-9_])Box<'; then
    deny "BLOCKED: \`Box<T>\` in a vehje no_std crate. Store by value or take a reference."
fi

# Bare `Option` / `Result` / numerics are blocked by the dedicated
# hook `no-bare-primitive-guard.sh` (full-line coverage across all
# vehje crates, not just pub fn sigs in no_std ones). This hook
# stays focused on heap / alloc paths.

allow
